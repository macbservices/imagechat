# Copie para functions/.env e preencha. NÃO commitar functions/.env.
#
# GEMINI_API_KEY: a mesma chave usada no projeto Honeless (restrita à
# Generative Language API). Em produção, prefira registrar como secret:
#   firebase functions:secrets:set GEMINI_API_KEY
# Para o emulador local, deixe aqui em functions/.env.
GEMINI_API_KEY=

# Lista de e-mails de administradores, separados por vírgula.
ADMIN_EMAILS=voce@exemplo.com,outro-admin@exemplo.com

# Opcional: sobrescreve o modelo do Gemini.
# GEMINI_MODEL=gemini-3.6-flash
