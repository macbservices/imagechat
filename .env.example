# Config do app web do Firebase.
# Firebase Console -> Project settings -> General -> Your apps -> Web app -> SDK setup.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Base das functions. Enquanto o backend roda na Vercel, aponte para lá:
#   VITE_FUNCTIONS_BASE_URL=https://<seu-projeto>.vercel.app/api
# Vazio = "/api" (proxy do Vite em dev via `vercel dev`, ou Cloud Functions atrás
# do Hosting quando o Firebase Blaze voltar).
VITE_FUNCTIONS_BASE_URL=

# true para apontar Auth + Firestore para os emuladores locais.
VITE_USE_EMULATORS=false
